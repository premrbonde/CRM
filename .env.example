# FastAPI Configurations
DATABASE_URL=sqlite:///./crm.db
SECRET_KEY=supersecretjwtkeyforcrmapplication2026!
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq API Configuration
# Get your key from https://console.groq.com/
GROQ_API_KEY=

# System Settings
# If MOCK_LLM is True, the system will use a local NLP rule engine / structured extractor 
# to parse conversations and trigger tools, so it works fully without a Groq API Key.
MOCK_LLM=True
